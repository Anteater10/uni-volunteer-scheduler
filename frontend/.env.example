# frontend/.env.example
#
#     cp frontend/.env.example frontend/.env
#
# Both keys are read by Vite at BUILD time and inlined into the bundle. They are
# not runtime configuration: changing either one means rebuilding the image, and
# `docker compose restart frontend` will not pick up a new value. This is the
# most common way a deploy looks healthy and is broken — the container is up, the
# page renders, and every API call goes to the wrong origin.

# Origin the SPA calls. Dev: the backend published on your laptop. Production:
# the public https origin, same host the SPA is served from, because Caddy routes
# /api/* to the backend (see the Caddyfile) — NOT the internal `backend:8000`
# name, which a browser cannot resolve.
VITE_API_URL=http://localhost:8000

# Shows or hides the copilot drawer. This is presentation only: it does not
# disable the backend copilot endpoints, and COPILOT_ENABLED in backend/.env is
# the switch that actually gates the feature. Set both.
VITE_COPILOT_ENABLED=true
