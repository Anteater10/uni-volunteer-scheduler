# backend/.env.example — DEVELOPMENT
#
# Copy to backend/.env and you have a working local stack. Every value here is
# either a real dev default or safe to leave as-is; the only ones you must fill
# in yourself are the two marked FILL IN, and the app runs without both (the
# copilot answers with a provider error, everything else works).
#
#     cp backend/.env.example backend/.env
#     cp frontend/.env.example frontend/.env
#     docker compose up
#
# The hostnames below (db, redis, mailpit) are compose service names, so they
# resolve inside the docker network and NOT from your laptop. Postgres and Redis
# are deliberately not published to localhost — see CLAUDE.md for how to run the
# backend test suite against the network.
#
# For production use backend/.env.production.example instead. It is a different
# file on purpose: this one enables a testing flag that leaks auth tokens.

# --- Core DB --- the `db` service (pgvector/pgvector:pg16 — the vector
# extension is required by migration 0019, so a plain postgres image will not do)
DATABASE_URL=postgresql://postgres:postgres@db:5432/uni_volunteer

# --- JWT --- fine to leave; regenerate for anything reachable by other people:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-only-not-a-secret-regenerate-for-anything-real
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=60
REFRESH_TOKEN_EXPIRES_DAYS=14

# --- Redis / Celery --- three separate databases on one Redis: cache, broker,
# results. celery_worker and celery_beat are load-bearing in dev too — reminders,
# broadcast pacing and the idle-session sweep all live there.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Email --- dev sends through Mailpit, which accepts everything and delivers
# nothing. Open http://localhost:8025 to read what the app sent. Do not point a
# dev stack at SendGrid: the seeded data uses invented addresses, and bouncing
# mail at a real provider damages the sender reputation of the domain you will
# need in production.
EMAIL_MODE=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USE_TLS=false
EMAIL_FROM_ADDRESS=dev@localhost

# --- Public URLs --- what gets written into magic links, reminder emails and
# ICS files. FRONTEND_URL is the only key config.py reads for the frontend
# origin; FRONTEND_BASE_URL is silently ignored (extra="ignore"), so setting
# only that one leaves every emailed link pointing at the default.
FRONTEND_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:8000

# --- Rate limiting --- per IP per path, backed by Redis. Fails OPEN if Redis is
# unreachable, deliberately: a Redis outage must not stop signups.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# --- Login lockout --- per account, so it still applies when the per-IP limiter
# above is failing open. 10 wrong passwords locks the account for 15 minutes. A
# locked account gets the same 401 as a wrong password on purpose, so the only
# place the lock is visible is the audit log (action `user_login_locked`).
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=15

# --- Copilot (v1.4) ---
# FILL IN to use the copilot: a free OpenRouter key from
# https://openrouter.ai/keys. Without it the drawer opens and then reports a
# provider error; nothing else in the app depends on it.
OPENROUTER_API_KEY=
COPILOT_ENABLED=true
# Free tiers only — a paid slug on a free key 403s on every message. OpenRouter
# retires ":free" tiers without notice; if both of these start 404ing, re-check
# the live list rather than guessing (the curl one-liner is in app/config.py).
COPILOT_PRIMARY_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
COPILOT_FALLBACK_MODEL=google/gemma-4-31b-it:free
# The tool-using agent loop. On in dev and in production. Setting it to false is
# the supported rollback — the disabled path returns a real 503, not a 500.
COPILOT_AGENT_LOOP_ENABLED=true
# Lets the copilot's two mail tools actually queue mail (dev: straight into
# Mailpit, so it is safe to try). Off means they refuse and say so.
COPILOT_OUTBOUND_EMAIL_ENABLED=false
COPILOT_MAX_OUTBOUND_RECIPIENTS=200
# Must match how the shipped corpus was embedded. Both retrieval CTEs filter
# chunks by provider, so the wrong value here reads zero rows from both halves
# of hybrid retrieval: no citations, no error, no clue.
CORPUS_EMBEDDING_PRIMARY=local
# FILL IN only if you set CORPUS_EMBEDDING_PRIMARY=jina.
JINA_API_KEY=

# --- Seed admin --- created by the migrate step; this is who you log in as.
SEED_ADMIN_EMAIL=admin@e2e.example.com
SEED_ADMIN_PASSWORD=Admin!2345

# --- Ops ---
LOG_LEVEL=INFO
# Empty = error monitoring off. Leave it off in dev unless you are specifically
# testing Sentry: dev exceptions in a shared project drown the real ones.
SENTRY_DSN=

# --- Dev/test only ---
DEBUG=false
ENVIRONMENT=development
# Mounts unauthenticated destructive test-helper endpoints, disables rate
# limiting, and returns confirmation tokens in signup responses so Playwright can
# follow a magic link without reading mail. All three at once, from this one
# variable. The app REFUSES TO BOOT if it is set while ENVIRONMENT=production.
EXPOSE_TOKENS_FOR_TESTING=1
