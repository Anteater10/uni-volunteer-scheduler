# backend/.env.production.example
# Copy to backend/.env.production and fill in. The real file is gitignored.
# Generate FRESH secrets — never reuse the dev values that were committed/pasted.

# --- Core DB --- (the `db` service on the compose network; or a managed URL)
# The password here MUST match the POSTGRES_PASSWORD you export for compose.
# The Postgres MUST have the pgvector extension available (corpus retrieval).
DATABASE_URL=postgresql://postgres:CHANGE_ME_DB_PASSWORD@db:5432/uni_volunteer

# --- JWT --- generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_FRESH_64_CHAR_HEX
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=60
REFRESH_TOKEN_EXPIRES_DAYS=14

# --- Redis / Celery --- (the `redis` service; or a managed URL)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Email / SendGrid ---
EMAIL_MODE=sendgrid
SENDGRID_API_KEY=CHANGE_ME_SENDGRID_KEY
EMAIL_FROM_ADDRESS=verified-sender@yourdomain.org

# --- Public URLs --- (emails, magic links, QR check-in, CORS). Use real https URLs.
# FRONTEND_URL is the ONLY key config.py reads for the frontend origin
# (frontend_base_url is a read-only alias for it, not a separate setting).
# FRONTEND_BASE_URL is NOT read (config.py's extra="ignore" silently drops
# it) — setting only that key leaves every magic link, reset link, invite
# link, and ICS URL pointing at the http://localhost:5173 default.
FRONTEND_URL=https://scitrek.example.org
BACKEND_BASE_URL=https://scitrek.example.org
CORS_ALLOWED_ORIGINS=https://scitrek.example.org

# --- Rate limiting ---
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# --- Copilot (v1.4) ---
OPENROUTER_API_KEY=CHANGE_ME_OPENROUTER_KEY
COPILOT_PRIMARY_MODEL=openai/gpt-oss-120b:free
COPILOT_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct:free
COPILOT_ENABLED=true
# LLM-surface guardrails: per-user messages/minute + org-wide tokens/day
# (0 disables the budget). Tune once real usage data exists.
COPILOT_RATE_LIMIT_MESSAGES_PER_MINUTE=10
COPILOT_DAILY_TOKEN_BUDGET=500000
# The copilot's two mail tools (send_reminder_email, nudge_understaffed_module)
# have no transport bound to them. Leave this off. Turning it on does not make
# them send — they still refuse, by design — it only exists so that wiring a
# transport is a deliberate, reviewable act rather than something that starts
# happening the moment somebody fills in the seam. Recipients are capped
# because the agent picks them from a model's reading of a sentence.
COPILOT_OUTBOUND_EMAIL_ENABLED=false
COPILOT_MAX_OUTBOUND_RECIPIENTS=200
# End-of-session profile extraction (cross-session "remembers you" memory).
# OFF. It is an unattended LLM call per closed session, plus up to three
# retries, drawing on the same OpenRouter free-tier request budget as the
# chat a user is waiting on — ~50 requests/day on an unfunded account. A
# background job spending those leaves a real question answered with a
# rate-limit error the user cannot account for. Turn on only once the
# account has a request budget worth metering; see the K31 note in
# app/tasks/extract_profile.py.
COPILOT_PROFILE_EXTRACTION_ENABLED=false
# The tool-using agent loop (Phase B). OFF for this deploy.
#
# This is not indecision — the decision was made and recorded on 2026-08-06
# (see the DECIDED box in .planning/FINAL-ROADMAP.md, W3): the copilot ships
# as a full tool-using agent, not as retrieval-grounded Q&A. The capability
# is built and merged; twelve tools, a confirmation-card flow, and a
# per-turn token ledger.
#
# It ships off because the tool layer has never run against a real model on
# real data — every test to date drives it through a monkeypatch — and the
# unfunded OpenRouter account allows roughly 50 requests/day, which is not
# enough to earn that confidence before handoff. An agent that can write is
# not something to find out about in production.
#
# Turning it on is safe to attempt: K23 made the disabled path return a real
# 503 with a message instead of the bare HTTP 500 it used to. Flip it only
# after the account is funded and someone has exercised a full write turn —
# propose, confirm, apply — end to end. It is reversible; nothing persists
# that a restart with the flag off cannot ignore.
#
# One copy change goes with the flip: the drawer header says "Can't see live
# rosters or signups", which becomes false the moment the agent can act.
COPILOT_AGENT_LOOP_ENABLED=false
# Retrieval provider must match how the corpus was embedded (see Phase 32 note).
CORPUS_EMBEDDING_PRIMARY=local

# --- Seed admin --- (created by the migrate step). Use a strong password.
SEED_ADMIN_EMAIL=admin@yourdomain.org
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# --- Ops ---
LOG_LEVEL=INFO
# Error monitoring (optional). Empty = off. Create a free Sentry project and
# paste its DSN to capture unhandled API + Celery exceptions.
SENTRY_DSN=

# --- PRODUCTION SAFETY ---
DEBUG=false
# ENVIRONMENT=production disables /docs and makes the app REFUSE TO BOOT if
# EXPOSE_TOKENS_FOR_TESTING is set. docker-compose.prod.yml also sets this;
# keeping it here covers non-compose deployments.
ENVIRONMENT=production
# DO NOT set EXPOSE_TOKENS_FOR_TESTING in production. Its absence = off.
# (When ON, signup responses leak auth tokens — dev/E2E only.)
