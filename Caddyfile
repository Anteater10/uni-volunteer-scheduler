# Caddy edge proxy: terminates TLS (automatic HTTPS via Let's Encrypt) and routes
# traffic for the production single-host stack (docker-compose.prod.yml).
#
# Requirements for automatic HTTPS to work:
#   - DOMAIN env var set (e.g. scitrek.example.org)
#   - a DNS A/AAAA record for that domain pointing at this host
#   - ports 80 and 443 reachable from the public internet
#
# For local testing without a real domain, set DOMAIN=localhost (Caddy issues a
# local self-signed cert) or use `http://` to skip TLS.
{$DOMAIN} {
    encode gzip

    # Browsers may only ever reach this host over HTTPS after first contact.
    header Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # API surface (REST + SSE streaming) -> FastAPI backend. /docs, /redoc
    # and /openapi.json stay routed but the backend disables them when
    # ENVIRONMENT=production, so they 404 in prod.
    # reverse_proxy streams Server-Sent Events correctly out of the box.
    @api path /api/* /openapi.json /docs /redoc
    handle @api {
        reverse_proxy backend:8000 {
            # Overwrite, do not append. Caddy's default is to append the
            # peer address to any X-Forwarded-For the client sent, and
            # uvicorn reads the *leftmost* entry — so a client sending
            # "X-Forwarded-For: 9.9.9.9" chooses its own rate-limit bucket
            # and can mint a fresh one per request. {remote_host} is the
            # address of the TCP peer, which the client cannot forge.
            header_up X-Forwarded-For {remote_host}
        }
    }

    # Everything else -> the static React SPA.
    handle {
        reverse_proxy frontend:80
    }
}
