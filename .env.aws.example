# Template for the AWS single-host deploy (docker-compose.aws.yml).
#
# Copy to .env at the repo root and fill in the real domain, then run
# `docker compose -f docker-compose.aws.yml up -d --build` from the same
# directory — Compose auto-loads .env for variable substitution, so nothing
# here needs to be `export`ed by hand. That matters: these three are the only
# things Caddy and the frontend build need to get right, and a value left as
# a literal placeholder (never substituted) reaches Caddy as-is and makes it
# crash-loop trying to issue a TLS certificate for that placeholder string.
#
# .env is gitignored (see .gitignore) — this .example file is the only one of
# the two that's tracked.

# The real public hostname, e.g. sci-trek.org or app.scitrek-ucsb.org.
# Must already have a DNS A record pointing at this instance's Elastic IP —
# Caddy's automatic HTTPS (Let's Encrypt) issues certs for hostnames it can
# be reached at, never for a bare IP or an unresolvable name.
DOMAIN=

# Build-time only: Vite inlines this into the JS bundle when the `frontend`
# image is built, so changing it later requires rebuilding that image, not
# just recreating the container. Almost always https://$DOMAIN.
VITE_API_URL=https://

# Build-time only, same caveat as VITE_API_URL. This is the frontend half of
# the copilot feature flag; COPILOT_ENABLED=true in backend/.env.production
# is the backend half, and both are required for the copilot UI to appear.
# true or false — do not leave unset (docker-compose.aws.yml requires it).
VITE_COPILOT_ENABLED=false
